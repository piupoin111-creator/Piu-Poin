        function changeSlide(n) {
            if(!bannerImages || bannerImages.length === 0) return;
            const slides = document.querySelectorAll('.slide');
            const dots = document.querySelectorAll('#slideDots button');
            if(slides.length === 0) return;

            slides[currentSlideIndex].classList.remove('active');
            if(dots[currentSlideIndex]) dots[currentSlideIndex].className = "w-2.5 h-2.5 rounded-full bg-white/50 transition";

            currentSlideIndex = (currentSlideIndex + n + slides.length) % slides.length;

            slides[currentSlideIndex].classList.add('active');
            if(dots[currentSlideIndex]) dots[currentSlideIndex].className = "w-2.5 h-2.5 rounded-full bg-white transition";
        }

        function currentSlide(n) {
            if(!bannerImages || bannerImages.length === 0) return;
            const slides = document.querySelectorAll('.slide');
            const dots = document.querySelectorAll('#slideDots button');
            if(slides.length === 0) return;

            slides[currentSlideIndex].classList.remove('active');
            if(dots[currentSlideIndex]) dots[currentSlideIndex].className = "w-2.5 h-2.5 rounded-full bg-white/50 transition";

            currentSlideIndex = n;

            slides[currentSlideIndex].classList.add('active');
            if(dots[currentSlideIndex]) dots[currentSlideIndex].className = "w-2.5 h-2.5 rounded-full bg-white transition";
        }

