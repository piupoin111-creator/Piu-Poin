                return;
            }

            container.classList.remove('hidden');
            wrapper.innerHTML = '';
            dotsContainer.innerHTML = '';

            bannerImages.forEach((b, index) => {
                const isActive = index === 0 ? 'active' : '';
                wrapper.innerHTML += `
                    <div class="slide ${isActive} w-full h-full absolute inset-0 transition-opacity duration-500">
                        <a href="${b.link || '#'}" ${b.link ? 'target="_blank"' : ''} class="w-full h-full block">
