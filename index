            let grandTotal = subtotal + shippingFee;

            const orderPayload = {
                type: "new_order",
                name: name, phone: phone, address: address,
                zone: selectedZoneName, notes: notes,
                items: rawItemsListText, total: grandTotal
            };

            fetch(FIXED_GOOGLE_SHEET_URL, {
                method: "POST", mode: "no-cors",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(orderPayload)
            }).catch(err => console.log("Cloud sync error", err));

            let message = `*🛒 طلب جديد من متجر Piu Poin*\n\n`;
            message += `👤 *الاسم:* ${name}\n`;
            message += `📞 *الهاتف:* ${phone}\n`;
            message += `📍 *العنوان:* ${address}\n`;
            if(selectedZoneName) message += `🚚 *منطقة الشحن:* ${selectedZoneName}\n`;
            if(notes) message += `📝 *ملاحظات:* ${notes}\n\n`;
            message += `📦 *المنتجات المطلوبة:*\n${itemsSummaryText}\n`;
            if(shippingFee > 0) message += `🚚 تكلفة الشحن: ${shippingFee} ج.م\n`;
            message += `💰 *الإجمالي الكلي:* *${grandTotal} ج.م*\n`;

            let whatsappUrl = `https://wa.me/${storeConfig.whatsapp}?text=` + encodeURIComponent(message);
            cart = []; updateCartBadge(); toggleCartModal();
            window.open(whatsappUrl, '_blank');
        }
    </script>
</body>
</html>
