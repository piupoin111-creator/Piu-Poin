<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title id="pageTitle">Piu Poin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { cairo: ['Cairo', 'sans-serif'] },
                    colors: { primary: '#2563eb', secondary: '#ca8a04' }
                }
            }
        }
    </script>
    <style> 
        body { font-family: 'Cairo', sans-serif; } 
        .slide { display: none; }
        .slide.active { display: block; }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col">

    <!-- النافبار العلوي -->
    <header id="mainHeader" class="bg-primary text-white shadow-md sticky top-0 z-40 transition-colors duration-300">
        <div class="container mx-auto px-4 py-3 flex justify-between items-center">
            <div class="flex items-center gap-3">
                <div id="navLogoContainer" class="w-11 h-11 rounded-full bg-white/20 flex items-center justify-center overflow-hidden shadow-inner border border-white/30">
                    <img id="navLogoImg" src="" alt="شعار" class="w-full h-full object-cover hidden">
                    <div id="defaultLogoSvg" class="w-full h-full bg-gradient-to-tr from-amber-500 to-orange-500 flex items-center justify-center font-black text-white text-lg tracking-tighter shadow">PP</div>
                </div>
                <div>
                    <h1 id="navStoreName" class="font-bold text-lg leading-tight">Piu Poin</h1>
                    <div id="navSocialIcons" class="flex items-center gap-2 mt-0.5"></div>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <button onclick="toggleCartModal()" class="relative bg-white/10 hover:bg-white/20 p-2.5 rounded-full transition flex items-center gap-2 px-3">
                    <i class="fa-solid fa-cart-shopping text-lg"></i>
                    <span id="cartBadge" class="bg-secondary text-white text-xs font-bold px-2 py-0.5 rounded-full">0</span>
                </button>
                <button onclick="openAdminModal()" class="bg-white/10 hover:bg-white/20 p-2.5 rounded-full transition" title="لوحة التحكم">
                    <i class="fa-solid fa-gear text-lg"></i>
                </button>
            </div>
        </div>
    </header>

    <!-- المحتوى الرئيسي للمتجر -->
    <main class="container mx-auto px-4 py-6 flex-grow">
        
        <!-- واجهة الإعلانات الاحترافية -->
        <div id="bannerContainer" class="mb-6 rounded-2xl overflow-hidden shadow-md bg-slate-200 relative h-40 sm:h-56 md:h-72 hidden">
            <div id="slidesWrapper" class="w-full h-full relative"></div>
            <button onclick="changeSlide(-1)" class="absolute right-2 top-1/2 -translate-y-1/2 bg-black/40 hover:bg-black/60 text-white w-8 h-8 rounded-full flex items-center justify-center transition"><i class="fa-solid fa-chevron-right text-xs"></i></button>
            <button onclick="changeSlide(1)" class="absolute left-2 top-1/2 -translate-y-1/2 bg-black/40 hover:bg-black/60 text-white w-8 h-8 rounded-full flex items-center justify-center transition"><i class="fa-solid fa-chevron-left text-xs"></i></button>
            <div id="slideDots" class="absolute bottom-3 left-0 right-0 flex justify-center gap-1.5"></div>
        </div>

        <div class="mb-6 flex flex-col md:flex-row gap-4 justify-between items-center">
            <div class="relative w-full md:w-96">
                <input type="text" id="searchInput" oninput="filterProducts()" placeholder="ابحث عن منتج..." class="w-full bg-white border border-slate-200 rounded-xl px-4 py-3 pr-11 text-sm focus:outline-none focus:border-primary shadow-sm">
                <i class="fa-solid fa-magnifying-glass absolute right-4 top-3.5 text-slate-400"></i>
            </div>
            <div id="categoryFilters" class="flex gap-2 overflow-x-auto w-full md:w-auto pb-2 md:pb-0">
                <button onclick="setCategory('all')" class="cat-btn px-4 py-2 rounded-xl text-sm font-semibold bg-primary text-white transition shadow-sm">الكل</button>
            </div>
        </div>

        <div id="productsGrid" class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4"></div>
    </main>

    <!-- وصف الموقع السفلي -->
    <footer class="bg-white border-t border-slate-200 py-6 px-4 mt-auto">
        <div class="container mx-auto text-center space-y-2">
            <h3 id="footerStoreName" class="font-bold text-base text-slate-800">Piu Poin</h3>
            <p id="footerStoreDesc" class="text-xs text-slate-500 max-w-xl mx-auto leading-relaxed">أفضل المنتجات وأحدث العروض والأسعار تجدها هنا دائماً.</p>
            <p class="text-[10px] text-slate-400 pt-2">جميع الحقوق محفوظة © 2026</p>
        </div>
    </footer>

    <!-- زر واتساب العائم -->
    <a id="floatingWhatsappBtn" href="https://wa.me/201000000000" target="_blank" class="fixed bottom-6 left-6 bg-green-600 text-white w-14 h-14 rounded-full shadow-2xl flex items-center justify-center text-3xl hover:scale-110 transition z-40" title="تواصل مع البائع عبر واتساب">
        <i class="fa-brands fa-whatsapp"></i>
    </a>

    <!-- نافذة السلة -->
    <div id="cartModal" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 hidden flex justify-end">
        <div class="bg-white w-full max-w-md h-full flex flex-col shadow-2xl">
            <div class="p-4 border-b border-slate-100 flex justify-between items-center bg-slate-50">
                <h3 class="font-bold text-lg flex items-center gap-2"><i class="fa-solid fa-cart-shopping text-primary"></i> سلة الطلبات وبيانات العميل</h3>
                <button onclick="toggleCartModal()" class="text-slate-400 hover:text-slate-600"><i class="fa-solid fa-xmark text-xl"></i></button>
            </div>
            
            <div class="flex-grow overflow-y-auto p-4 space-y-4">
                <div id="cartItemsContainer" class="space-y-3"></div>

                <div class="bg-slate-50 p-3 rounded-xl border border-slate-200 space-y-3">
                    <h4 class="font-bold text-xs text-primary">بيانات التوصيل الخاصة بك:</h4>
                    <div>
                        <label class="text-[11px] text-slate-600 font-semibold">الاسم:</label>
                        <input type="text" id="clientName" placeholder="أدخل اسمك الكامل" class="w-full bg-white border border-slate-200 rounded-lg p-2 text-xs mt-1 focus:outline-none focus:border-primary">
                    </div>
                    <div>
                        <label class="text-[11px] text-slate-600 font-semibold">رقم الموبايل:</label>
                        <input type="tel" id="clientPhone" placeholder="رقم الهاتف للتواصل" class="w-full bg-white border border-slate-200 rounded-lg p-2 text-xs mt-1 focus:outline-none focus:border-primary">
                    </div>
                    <div>
                        <label class="text-[11px] text-slate-600 font-semibold">العنوان بالتفصيل:</label>
                        <textarea id="clientAddress" rows="2" placeholder="الشارع، العمارة، الدور، الشقة..." class="w-full bg-white border border-slate-200 rounded-lg p-2 text-xs mt-1 focus:outline-none focus:border-primary"></textarea>
                    </div>
                    <div>
                        <label class="text-[11px] text-slate-600 font-semibold">ملاحظات إضافية (اختياري):</label>
                        <input type="text" id="clientNotes" placeholder="مثال: الأوردر مستعجل..." class="w-full bg-white border border-slate-200 rounded-lg p-2 text-xs mt-1 focus:outline-none focus:border-primary">
                    </div>
                </div>
            </div>

            <div class="p-4 border-t border-slate-100 bg-slate-50 space-y-3">
                <div class="space-y-1">
                    <label class="text-xs font-bold text-slate-600">اختر منطقة التوصيل:</label>
                    <select id="deliveryZoneSelect" onchange="updateCartTotal()" class="w-full bg-white border border-slate-200 rounded-xl p-2.5 text-sm focus:outline-none focus:border-primary"></select>
                </div>
                <div class="flex justify-between items-center text-lg font-bold">
                    <span>الإجمالي الكلي (شامل الشحن):</span>
                    <span id="cartTotalPrice" class="text-primary">0 ج.م</span>
                </div>
                <button onclick="checkoutWhatsApp()" class="w-full bg-green-600 hover:bg-green-700 text-white font-bold py-3 rounded-xl transition flex items-center justify-center gap-2 shadow-md">
                    <i class="fa-brands fa-whatsapp text-xl"></i> إتمام الطلب عبر واتساب
                </button>
            </div>
        </div>
    </div>

    <!-- نافذة دخول البائع -->
    <div id="adminLoginModal" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white w-full max-w-sm rounded-2xl shadow-2xl p-6 space-y-4">
            <div class="flex justify-between items-center">
                <h3 class="font-bold text-lg">لوحة تحكم البائع</h3>
                <button onclick="closeAdminLogin()" class="text-slate-400 hover:text-slate-600"><i class="fa-solid fa-xmark text-xl"></i></button>
            </div>
            <div>
                <label class="text-xs font-bold text-slate-600 mb-1 block">كلمة المرور:</label>
                <input type="password" id="adminPasswordInput" class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-sm focus:outline-none focus:border-primary" placeholder="أدخل كلمة المرور">
            </div>
            <button onclick="verifyAdminPassword()" class="w-full bg-primary text-white font-bold py-3 rounded-xl transition shadow-md">دخول</button>
        </div>
    </div>

    <!-- لوحة إعدادات البائع -->
    <div id="adminDashboardModal" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 hidden flex justify-end">
        <div class="bg-white w-full max-w-xl h-full flex flex-col shadow-2xl">
            <div class="p-4 border-b border-slate-100 flex justify-between items-center bg-primary text-white">
                <h3 class="font-bold text-lg flex items-center gap-2"><i class="fa-solid fa-sliders"></i> لوحة تحكم وإدارة المتجر</h3>
                <button onclick="closeAdminDashboard()" class="text-white/80 hover:text-white"><i class="fa-solid fa-xmark text-xl"></i></button>
            </div>
            
            <div class="flex-grow overflow-y-auto p-6 space-y-6">
                <!-- إعدادات عامة -->
                <div class="space-y-3 bg-slate-50 p-4 rounded-xl border border-slate-100">
                    <h4 class="font-bold text-sm text-primary">البيانات الأساسية وشعار ومتجر الموقع</h4>
                    <div>
                        <label class="text-xs font-semibold text-slate-600">اسم المتجر:</label>
                        <input type="text" id="settingStoreName" class="w-full bg-white border border-slate-200 rounded-lg p-2.5 text-sm mt-1">
                    </div>
                    <div>
                        <label class="text-xs font-semibold text-slate-600">وصف الموقع:</label>
                        <textarea id="settingStoreDesc" rows="2" class="w-full bg-white border border-slate-200 rounded-lg p-2.5 text-sm mt-1"></textarea>
                    </div>
                    <div>
                        <label class="text-xs font-semibold text-slate-600">اختر شعار المتجر:</label>
                        <input type="file" id="settingLogoFile" accept="image/*" onchange="handleLogoUpload(event)" class="w-full bg-white border border-slate-200 rounded-lg p-2 text-sm mt-1">
                    </div>
                    <div>
                        <label class="text-xs font-semibold text-slate-600">رقم واتساب البائع:</label>
                        <input type="text" id="settingWhatsApp" class="w-full bg-white border border-slate-200 rounded-lg p-2.5 text-sm mt-1">
                    </div>
                    <div>
                        <label class="text-xs font-semibold text-slate-600">رابط جوجل شيت (Web App URL):</label>
                        <input type="text" id="settingGoogleSheet" readonly class="w-full bg-slate-100 text-slate-500 border border-slate-200 rounded-lg p-2.5 text-sm mt-1 cursor-not-allowed" title="الرابط مثبت ومقفل نهائياً">
                    </div>
                    <div>
                        <label class="text-xs font-semibold text-slate-600">لون الهوية البصرية:</label>
                        <input type="color" id="settingColor" class="w-full h-10 bg-white border border-slate-200 rounded-lg p-1 mt-1 cursor-pointer">
                    </div>
                </div>

                <!-- التواصل -->
                <div class="space-y-3 bg-slate-50 p-4 rounded-xl border border-slate-100">
                    <h4 class="font-bold text-sm text-primary">إدارة روابط التواصل الاجتماعي</h4>
                    <div class="grid grid-cols-2 gap-2">
                        <select id="newSocialPlatform" class="bg-white border border-slate-200 rounded-lg p-2 text-sm">
                            <option value="facebook">فيسبوك</option>
                            <option value="instagram">إنستجرام</option>
                            <option value="tiktok">تيك توك</option>
                            <option value="youtube">يوتيوب</option>
                            <option value="telegram">تليجرام</option>
                            <option value="globe">موقع إلكتروني</option>
                        </select>
                        <input type="text" id="newSocialUrl" placeholder="رابط الحساب" class="bg-white border border-slate-200 rounded-lg p-2 text-sm">
                    </div>
                    <button onclick="addSocialLink()" class="w-full bg-secondary text-white text-sm font-bold py-2 rounded-lg shadow transition">إضافة رابط التواصل</button>
                    <div id="adminSocialList" class="space-y-2 max-h-32 overflow-y-auto mt-2"></div>
                </div>

                <!-- البانرات -->
                <div class="space-y-3 bg-slate-50 p-4 rounded-xl border border-slate-100">
                    <h4 class="font-bold text-sm text-primary">إدارة واجهة الإعلانات</h4>
                    <div class="space-y-2">
                        <input type="file" id="newBannerFile" accept="image/*" class="w-full bg-white border border-slate-200 rounded-lg p-2 text-sm">
                        <input type="text" id="newBannerLink" placeholder="رابط عند الضغط على الإعلان" class="w-full bg-white border border-slate-200 rounded-lg p-2 text-sm">
                    </div>
                    <button onclick="addBannerImage()" class="w-full bg-secondary text-white text-sm font-bold py-2 rounded-lg shadow transition">إضافة صورة للإعلانات</button>
                    <div id="adminBannersList" class="space-y-2 max-h-36 overflow-y-auto mt-2"></div>
                </div>

                <!-- مناطق الشحن -->
                <div class="space-y-3 bg-slate-50 p-4 rounded-xl border border-slate-100">
                    <h4 class="font-bold text-sm text-primary">إدارة مناطق وأسعار الشحن</h4>
                    <input type="hidden" id="editingZoneIndex" value="-1">
                    <div class="grid grid-cols-2 gap-2">
                        <input type="text" id="newZoneName" placeholder="اسم المنطقة" class="bg-white border border-slate-200 rounded-lg p-2 text-sm">
                        <input type="number" id="newZoneFee" placeholder="تكلفة الشحن (ج.م)" class="bg-white border border-slate-200 rounded-lg p-2 text-sm">
                    </div>
                    <button onclick="saveZoneItem()" id="zoneActionBtn" class="w-full bg-secondary text-white text-sm font-bold py-2 rounded-lg shadow transition">إضافة منطقة الشحن</button>
                    <div id="adminZonesList" class="space-y-2 max-h-36 overflow-y-auto mt-2"></div>
                </div>

                <!-- المنتجات -->
                <div class="space-y-3 bg-slate-50 p-4 rounded-xl border border-slate-100">
                    <h4 class="font-bold text-sm text-primary">إدارة وتعديل المنتجات والمجموعات</h4>
                    <input type="hidden" id="editingProductIndex" value="-1">
                    <div class="grid grid-cols-2 gap-2">
                        <input type="text" id="newProdName" placeholder="اسم المنتج" class="bg-white border border-slate-200 rounded-lg p-2 text-sm">
                        <input type="number" id="newProdPrice" placeholder="السعر (ج.م)" class="bg-white border border-slate-200 rounded-lg p-2 text-sm">
                    </div>
                    <div class="grid grid-cols-2 gap-2">
                        <input type="text" id="newProdDiscount" placeholder="خصم وهمي (مثال: خصم 20% أو عرض خاص)" class="bg-white border border-slate-200 rounded-lg p-2 text-sm">
                        <textarea id="newProdDesc" placeholder="وصف تفصيلي للمنتج (اختياري)" rows="1" class="bg-white border border-slate-200 rounded-lg p-2 text-sm"></textarea>
                    </div>
                    <div class="grid grid-cols-3 gap-2 items-center">
                        <div class="flex gap-1">
                            <select id="newProdCategory" class="w-full bg-white border border-slate-200 rounded-lg p-2 text-sm font-semibold text-slate-700">
                                <option value="">-- اختر المجموعة --</option>
                            </select>
                            <button type="button" onclick="addNewCategoryPrompt()" class="bg-primary text-white px-2.5 rounded-lg text-xs hover:bg-opacity-80 transition" title="إضافة مجموعة جديدة">
                                <i class="fa-solid fa-plus"></i>
                            </button>
                        </div>
                        <select id="newProdUnit" class="bg-white border border-slate-200 rounded-lg p-2 text-sm font-bold text-primary">
                            <option value="قطعة">قطعة</option>
                            <option value="كيلو">كيلو</option>
                            <option value="عبوة">عبوة</option>
                            <option value="دستة">دستة</option>
                        </select>
                        <input type="file" id="newProdImageFile" accept="image/*" class="bg-white border border-slate-200 rounded-lg p-1 text-xs">
                    </div>
                    <button onclick="saveProductItem()" id="productActionBtn" class="w-full bg-secondary text-white text-sm font-bold py-2 rounded-lg shadow transition">إضافة المنتج للقائمة</button>
                    <div id="adminProductsList" class="space-y-2 max-h-45 overflow-y-auto mt-2"></div>
                </div>

                <!-- زر الحفظ والتحديث الشامل -->
                <div class="pt-4 pb-6">
                    <button onclick="saveAndSyncEverything()" class="w-full bg-green-600 hover:bg-green-700 text-white font-extrabold py-4 rounded-2xl shadow-xl text-base flex items-center justify-center gap-2 transition transform active:scale-95">
                        <i class="fa-solid fa-cloud-arrow-up text-xl"></i> حفظ وتحديث النظام بالكامل
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        // 🔒 رابط جوجل شيت الجديد المثبت نهائياً وإجبارياً
        const FIXED_GOOGLE_SHEET_URL = "https://script.google.com/macros/s/AKfycby8l9JscC-mTuifFBfkRpyXVCfqEMUu2pWIu67IXhEFB80fHslB3gdBpejE4RFIhD2d/exec";

        const DEFAULT_PRODUCTS = [];
        const DEFAULT_ZONES = [
            { name: "القاهرة والجيزة", fee: 50 },
            { name: "الإسكندرية", fee: 60 }
        ];

        let storeConfig = JSON.parse(localStorage.getItem('general_store_config')) || {
            name: "Piu Poin",
            description: "أفضل المنتجات وأحدث العروض والأسعار تجدها هنا دائماً.",
            whatsapp: "201000000000",
            primaryColor: "#2563eb",
            logoUrl: ""
        };

        // فرض وتثبيت الرابط الجديد والاسم دائماً دون الالتفات لأي بيانات قديمة
        storeConfig.googleSheetUrl = FIXED_GOOGLE_SHEET_URL;
        storeConfig.name = "Piu Poin";

        const FIXED_ADMIN_PASSWORD = "444888";

        let socialLinks = JSON.parse(localStorage.getItem('general_store_social')) || [];
        let bannerImages = JSON.parse(localStorage.getItem('general_store_banners')) || [];
        
        let storedProds = JSON.parse(localStorage.getItem('general_store_products'));
        let products = (storedProds !== null && storedProds.length > 0) ? storedProds : DEFAULT_PRODUCTS;

        let storedZones = JSON.parse(localStorage.getItem('general_store_zones'));
        let deliveryZones = (storedZones !== null && storedZones.length > 0) ? storedZones : DEFAULT_ZONES;

        let cart = [];
        let currentCategory = 'all';
        let tempLogoBase64 = storeConfig.logoUrl || "";
        let currentSlideIndex = 0;
        let slideInterval = null;

        document.addEventListener('DOMContentLoaded', () => {
            renderEverything();
            fetchStoreDataFromCloudSilent();
        });

        function renderEverything() {
            applyStoreConfig();
            renderSocialIcons();
            renderBanners();
            renderCategoryFilters();
            renderProducts();
            populateDeliveryZones();
            populateProductCategories();
        }

        function populateProductCategories(selectedCategory = '') {
            const select = document.getElementById('newProdCategory');
            if (!select) return;
            const categories = [...new Set(products.map(p => p.category || 'عام'))];
            let optionsHtml = `<option value="">-- اختر المجموعة --</option>`;
            categories.forEach(cat => {
                const isSelected = (cat === selectedCategory) ? 'selected' : '';
                optionsHtml += `<option value="${cat}" ${isSelected}>${cat}</option>`;
            });
            select.innerHTML = optionsHtml;
        }

        function addNewCategoryPrompt() {
            let newCatName = prompt("أدخل اسم المجموعة الجديدة:");
            if (newCatName && newCatName.trim() !== "") {
                newCatName = newCatName.trim();
                const select = document.getElementById('newProdCategory');
                let exists = false;
                for (let i = 0; i < select.options.length; i++) {
                    if (select.options[i].value === newCatName) { exists = true; break; }
                }
                if (!exists) {
                    const opt = document.createElement('option');
                    opt.value = newCatName;
                    opt.textContent = newCatName;
                    opt.selected = true;
                    select.appendChild(opt);
                } else {
                    select.value = newCatName;
                }
                renderCategoryFilters();
            }
        }

        function fetchStoreDataFromCloudSilent() {
            const url = FIXED_GOOGLE_SHEET_URL + "?action=getData&t=" + new Date().getTime();
            fetch(url, { cache: 'no-store' })
                .then(res => res.json())
                .then(data => {
                    if (data && data.success) {
                        if (data.config && data.config.name) {
                            storeConfig = { ...storeConfig, ...data.config };
                        }
                        storeConfig.googleSheetUrl = FIXED_GOOGLE_SHEET_URL;
                        storeConfig.name = "Piu Poin";
                        
                        if (data.products && data.products.length > 0) {
                            products = data.products;
                            localStorage.setItem('general_store_products', JSON.stringify(products));
                        }
                        if (data.zones && data.zones.length > 0) {
                            deliveryZones = data.zones;
                            localStorage.setItem('general_store_zones', JSON.stringify(deliveryZones));
                        }
                        if (data.socialLinks) {
                            socialLinks = data.socialLinks;
                            localStorage.setItem('general_store_social', JSON.stringify(socialLinks));
                        }
                        if (data.bannerImages) {
                            bannerImages = data.bannerImages;
                            localStorage.setItem('general_store_banners', JSON.stringify(bannerImages));
                        }

                        tempLogoBase64 = storeConfig.logoUrl || "";
                        renderEverything();
                    }
                })
                .catch(err => {
                    console.log("العمل بالنسخة المحفوظة محلياً", err);
                });
        }

        function applyStoreConfig() {
